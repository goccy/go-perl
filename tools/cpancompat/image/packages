# The Debian packages of the environment distributions are tested in, for
# the image around gperl and for the image around perl itself alike: what
# differs between the two is the interpreter, nothing else.

# The C toolchain and the tools build scripts run.
build-essential ca-certificates curl git patch pkg-config unzip bzip2 xz-utils
cmake graphviz protobuf-compiler

